DATABASE_URL=postgresql://user:password@host/database?sslmode=require
AUTH_SECRET=replace-with-a-random-secret
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Auth.js v5 automatically trusts Vercel and infers the production host.
# AUTH_URL and AUTH_TRUST_HOST are not required for the standard Vercel setup.

